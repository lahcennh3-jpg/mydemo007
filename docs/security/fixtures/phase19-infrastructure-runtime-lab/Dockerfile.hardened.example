FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd --gid 10001 phase19 \
    && useradd \
       --uid 10001 \
       --gid 10001 \
       --no-create-home \
       --shell /usr/sbin/nologin \
       phase19

WORKDIR /app

COPY --chown=10001:10001 . /app

USER 10001:10001

EXPOSE 8080

CMD ["python", "-m", "http.server", "8080"]
