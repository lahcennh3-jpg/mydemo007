      "name": "cross_tenant_access_attempt",
      "severity": "high",
      "domain": "tenant_isolation",
      "required_signals": [
        "actor_tenant",
        "resource_tenant",
        "authorization_decision"
      ],
      "condition": "actor tenant differs from resource tenant during protected resource access",
      "triage": [
        "actor",
        "resource",
        "tenant pair",
        "authorization decision",
        "trace"
      ]
    },

    {
      "id": "D15-002",
      "name": "privilege_or_service_account_anomaly",
      "severity": "high",
      "domain": "authorization",
      "required_signals": [
        "actor_id",
        "role",
        "action",
        "baseline"
      ],
      "condition": "privileged action inconsistent with expected actor role or service identity",
      "triage": [
        "actor",
        "role",
        "action",
        "previous activity",
        "trace"
      ]
    },

    {
